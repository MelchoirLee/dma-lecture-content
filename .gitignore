# Isolated Jupyter config generated by present.sh
.jupyter-rise/

# Private virtual environment created by present.sh
.venv/

# Jupyter runtime artifacts
.virtual_documents/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/

# JupyterLab log from the devcontainer launcher
.devcontainer/logs/

# Run-button extension: source is committed, so is the built bundle under
# tools/jupyter-data/ (the codespace has no Node). These are local build spoil.
tools/rise-run-button/node_modules/
tools/rise-run-button/lib/
tools/rise-run-button/*.tsbuildinfo
tools/rise-run-button/.yarn/

# MongoDB data written by .devcontainer/start-jupyter.sh
.mongodb-data/

# Scratch data copies made by isolated lecture examples (see ed_to_ipynb.py)
notebooks/*-scratch.*

# Test databases built and removed by the lecture examples themselves
notebooks/index_test.db
notebooks/artists_tracks.db
notebooks/customers_orders.db

# CSV written by Lecture 31's fixed-width example
notebooks/books.csv
